# ---- Copy to .env.local and fill in your real values ----
# Live site URL — used for canonical tags, sitemap, robots, JSON-LD and OG tags.
# On Vercel set this to your deployment URL (or your custom domain once you buy one).
NEXT_PUBLIC_SITE_URL=https://craftivafurniture.vercel.app
NEXT_PUBLIC_SITE_NAME=Craftiva Furniture

# Quote-form lead capture (emails every submission to you). FREE.
# Get a key in 30s at https://web3forms.com — enter craftivafurniture@gmail.com,
# they email you an access key, paste it here (and add it in Vercel > Settings > Environment Variables).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# WhatsApp number in international format WITHOUT '+', e.g. 919711487229
NEXT_PUBLIC_WHATSAPP_NUMBER=919711487229
NEXT_PUBLIC_WHATSAPP_DISPLAY=+91 97114 87229

NEXT_PUBLIC_EMAIL=craftivafurniture@gmail.com
NEXT_PUBLIC_PHONE=+91 97114 87229
NEXT_PUBLIC_ADDRESS=3rd Floor, B-102, Timber Block, Block C, WHS, Kirti Nagar, New Delhi 110015
NEXT_PUBLIC_SERVICE_AREA=Delhi-NCR
NEXT_PUBLIC_GOOGLE_MAPS_URL=https://maps.google.com/?q=Craftiva+Furniture+Kirti+Nagar+New+Delhi

# Absolute or project-root-relative path to the product image library
IMAGES_ROOT=Images

# Analytics (optional, leave blank until you have real IDs)
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=